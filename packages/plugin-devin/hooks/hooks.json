{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${PLUGIN_ROOT}/hooks/bin/remnic-devin-hook.sh\" session-start",
          "timeout": 45
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${PLUGIN_ROOT}/hooks/bin/remnic-devin-hook.sh\" user-prompt-recall",
          "timeout": 20
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${PLUGIN_ROOT}/hooks/bin/remnic-devin-hook.sh\" post-tool-observe",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${PLUGIN_ROOT}/hooks/bin/remnic-devin-hook.sh\" post-tool-observe",
          "timeout": 10
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${PLUGIN_ROOT}/hooks/bin/remnic-devin-hook.sh\" post-compaction",
          "timeout": 30
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "sh \"${PLUGIN_ROOT}/hooks/bin/remnic-devin-hook.sh\" session-end",
          "timeout": 30
        }
      ]
    }
  ]
}
