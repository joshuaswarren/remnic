{
  "name": "@remnic/bench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal local UI shell for browsing Remnic benchmark result summaries.",
  "scripts": {
    "predev": "node ../../scripts/ensure-bench-ui-build-deps.mjs",
    "dev": "vite",
    "pretest": "node ../../scripts/ensure-bench-ui-build-deps.mjs",
    "test": "find src \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print | sort | xargs env NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=remnic-source\" tsx --test",
    "precheck-types": "node ../../scripts/ensure-bench-ui-build-deps.mjs",
    "check-types": "tsc --noEmit",
    "prebuild": "node ../../scripts/ensure-bench-ui-build-deps.mjs",
    "build": "pnpm run check-types && vite build"
  },
  "dependencies": {
    "@remnic/bench": "workspace:^",
    "react-router-dom": "^7.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@remnic/bench": "workspace:^",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  }
}
